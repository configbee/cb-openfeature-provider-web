    "@typescript-eslint/parser": "^8.6.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-util": "^30.5.1",
    "nx": "23.2.0",
    "ts-jest": "^29.4.12",
    "tslib": "^2.3.0"
  },
  "nx": {},
