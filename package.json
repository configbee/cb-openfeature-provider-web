  },
  "homepage": "https://github.com/configbee/cb-openfeature-provider-web#readme",
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.7.2"
  },
  "devDependencies": {
    "@nx/devkit": "23.2.0",
    "@nx/eslint-plugin": "^23.2.0",
    "@nx/jest": "^23.2.0",
    "@nx/js": "23.2.0",
    "@nx/plugin": "^23.2.0",
    "@nx/rollup": "^23.2.0",
    "@nx/web": "^23.2.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
